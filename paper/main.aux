\@writefile{lot}{\contentsline {table}{\numberline {A.1}{\ignorespaces Volledig $2\times 2\times 2$-SA-ontwerp met een capaciteitsvullende randomstart. Voor elke seed zijn $D$ en de interne solvertijd over de twaalf waves opgeteld. De resultaten zijn gebaseerd op tien gekoppelde seeds.}}{6}{table.A.1}\protected@file@percent }
\newlabel{tab:app-sa}{{A.1}{6}{Volledig $2\times 2\times 2$-SA-ontwerp met een capaciteitsvullende randomstart. Voor elke seed zijn $D$ en de interne solvertijd over de twaalf waves opgeteld. De resultaten zijn gebaseerd op tien gekoppelde seeds}{table.A.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.2}{\ignorespaces Gekoppelde SA-effecten op $D$. De Student-$t$-95\%-BI's zijn ongecorrigeerd. De kolom $p_{\mathrm  H}$ bevat de Holm-gecorrigeerde $p$-waarden voor zeven toetsen. De contrasten zijn $K$: Lundy--Mees min geometrisch, $B$: swap min relocate en $S$: willekeurig min greedy. Een positieve $\Delta D$ is ongunstig.}}{6}{table.A.2}\protected@file@percent }
\newlabel{tab:app-sa-effects}{{A.2}{6}{Gekoppelde SA-effecten op $D$. De Student-$t$-95\%-BI's zijn ongecorrigeerd. De kolom $p_{\mathrm H}$ bevat de Holm-gecorrigeerde $p$-waarden voor zeven toetsen. De contrasten zijn $K$: Lundy--Mees min geometrisch, $B$: swap min relocate en $S$: willekeurig min greedy. Een positieve $\Delta D$ is ongunstig}{table.A.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A.3}{\ignorespaces Gekoppelde GA-OFAT-contrasten. Elke rij geeft het verschil tussen de variant en de basis met populatie 12, twintig generaties, mutatiekans 0,20 en elitisme 0,08. De Student-$t$-95\%-BI's zijn ongecorrigeerd. De kolom $p_{\mathrm  H}$ bevat de Holm-gecorrigeerde $p$-waarden voor acht kwaliteitstoetsen.}}{6}{table.A.3}\protected@file@percent }
\newlabel{tab:app-ga}{{A.3}{6}{Gekoppelde GA-OFAT-contrasten. Elke rij geeft het verschil tussen de variant en de basis met populatie 12, twintig generaties, mutatiekans 0,20 en elitisme 0,08. De Student-$t$-95\%-BI's zijn ongecorrigeerd. De kolom $p_{\mathrm H}$ bevat de Holm-gecorrigeerde $p$-waarden voor acht kwaliteitstoetsen}{table.A.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B}Budget, schaalgedrag, waveverschillen en convergentie}{7}{appendix.B}\protected@file@percent }
