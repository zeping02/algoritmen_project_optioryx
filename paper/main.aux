\@writefile{lot}{\contentsline {table}{\numberline {B.1}{\ignorespaces Afzonderlijke Release-budgetstudie met tien gekoppelde seeds. Per seed zijn $D$ en de interne solvertijd over twaalf waves opgeteld. Winst is berekend als de greedyscore min de kandidaatscore, zodat een positieve waarde een verbetering aangeeft. De Student-$t$-95\%-BI's zijn ongecorrigeerd. De kolom $p_{\mathrm  H}$ bevat de Holm-gecorrigeerde $p$-waarden voor zeven budgettoetsen.}}{7}{table.B.1}\protected@file@percent }
\newlabel{tab:app-budget}{{B.1}{7}{Afzonderlijke Release-budgetstudie met tien gekoppelde seeds. Per seed zijn $D$ en de interne solvertijd over twaalf waves opgeteld. Winst is berekend als de greedyscore min de kandidaatscore, zodat een positieve waarde een verbetering aangeeft. De Student-$t$-95\%-BI's zijn ongecorrigeerd. De kolom $p_{\mathrm H}$ bevat de Holm-gecorrigeerde $p$-waarden voor zeven budgettoetsen}{table.B.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.2}{\ignorespaces De exponent $b$ is met een log--logregressie van $T(n)=a n^b$ geschat op vijf groottes en negen timings per grootte. Het Student-$t$-95\%-BI voor $b$ heeft drie vrijheidsgraden. De fit geldt alleen voor $50\leq n\leq 800$.}}{7}{table.B.2}\protected@file@percent }
\newlabel{tab:app-scaling}{{B.2}{7}{De exponent $b$ is met een log--logregressie van $T(n)=a n^b$ geschat op vijf groottes en negen timings per grootte. Het Student-$t$-95\%-BI voor $b$ heeft drie vrijheidsgraden. De fit geldt alleen voor $50\leq n\leq 800$}{table.B.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.3}{\ignorespaces De vier waves met Holm-significante winst voor SA--10\,000. Correctie gebeurt over alle twaalf wave-toetsen.}}{7}{table.B.3}\protected@file@percent }
\newlabel{tab:app-waves}{{B.3}{7}{De vier waves met Holm-significante winst voor SA--10\,000. Correctie gebeurt over alle twaalf wave-toetsen}{table.B.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {B.4}{\ignorespaces Lange convergentiestudie met tien seeds per budget. $t_{95}$ en $t_{99}$ zijn berekend binnen het eigen budget en alleen voor runs die verbeteren. De laatste kolom telt achtereenvolgens runs zonder winst, runs met winst in de laatste 10\% en runs met winst op de eindstap.}}{7}{table.B.4}\protected@file@percent }
\newlabel{tab:app-convergence}{{B.4}{7}{Lange convergentiestudie met tien seeds per budget. $t_{95}$ en $t_{99}$ zijn berekend binnen het eigen budget en alleen voor runs die verbeteren. De laatste kolom telt achtereenvolgens runs zonder winst, runs met winst in de laatste 10\% en runs met winst op de eindstap}{table.B.4}{}}
